{
  "manifest_version": 3,
  "name": "DLAB Code PTIT Filter",
  "version": "1.3.1",
  "description": "Lọc bài tập Đúng / Sai / Chưa làm trên Code PTIT.",
  "permissions": ["storage"],
  "action": {
    "default_title": "DLAB Filter - Tùy chỉnh kích thước",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://code.ptit.edu.vn/*",
        "*://dlab.ptit.edu.vn/*"
      ],
      "js": [
        "src/config.js",
        "src/storage.js",
        "src/classifier.js",
        "src/theme.js",
        "src/styles.js",
        "src/panel.js",
        "src/position.js",
        "src/drag.js",
        "src/tables.js",
        "src/scanner.js",
        "src/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
